# Copy this file to .env and fill in GOOGLE_API_KEY.
# .env is never committed to git; this file is.

GOOGLE_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
EMBED_MODEL=gemini-embedding-2

TOP_K=4
HISTORY_TURNS=3

SIMILARITY_THRESHOLD=0.67

# Ingest: how many chunks to embed per API call, and how many times to retry
# a batch after a quota/network error (waits 2, 4, 8, 16, 32... seconds)
EMBED_BATCH_SIZE=10
EMBED_MAX_RETRIES=6

CHROMA_PATH=storage/chroma
CHROMA_COLLECTION=knowledge
